#!/bin/bash
# Quick health summary for fileserver01 (used by the monitoring cron and by on-call)
[ -r /etc/nb-ops/monitor.env ] && . /etc/nb-ops/monitor.env
ok() { printf '  [ ok ] %s\n' "$1"; }
bad() { printf '  [FAIL] %s\n' "$1"; }
echo "fileserver01 health $(date -u +%FT%TZ)"
systemctl is-active --quiet nginx && ok nginx || bad nginx
systemctl is-active --quiet php8.3-fpm && ok php8.3-fpm || bad php8.3-fpm
df -P / | awk 'NR==2{u=$5+0; printf "  [%s] disk / %s used\n", (u<90?" ok ":"WARN"), $5}'
ls /var/backups/nb-intranet/db_*.sql >/dev/null 2>&1 && ok "backups present" || bad "no backups in /var/backups/nb-intranet"
curl -fsS -m 3 -u "$MON_ES_USER:$MON_ES_PASS" "$MON_ES_URL/_cluster/health" >/dev/null 2>&1 \
  && ok "search cluster" || bad "search cluster not answering ($MON_ES_URL)"
