server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name intranet.northbridge-logistics.com fileserver01;

    ssl_certificate     /etc/ssl/certs/nb-intranet.crt;
    ssl_certificate_key /etc/ssl/private/nb-intranet.key;

    root /var/www/northbridge/public;
    index index.php index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Laravel only handles the portal and its API; everything else is static
    location ~ ^/(admin|api|login|logout|storage)(/|$) {
        try_files $uri /index.php?$query_string;
    }

    location /admin/backups/ {
        alias /var/backups/nb/;
        autoindex on;
    }

    location /api/ollama/ {
        proxy_pass http://127.0.0.1:11434/;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
}
