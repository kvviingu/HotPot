[Unit]
Description=Collect fileserver01 audit events, quarantine new files, fetch URLs attackers tried
After=incus.service auditd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/sbin/nb-collect.py
Nice=10
# A run that grows too big is killed on its own instead of taking the host (and sshd) down with it
MemoryHigh=150M
MemoryMax=200M
IOSchedulingClass=idle
TimeoutStartSec=50
